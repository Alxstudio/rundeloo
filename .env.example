# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (public: safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (server only, bypasses RLS)
SUPABASE_SECRET_KEY=

# AI (server only)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Stripe (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Protects the cron endpoints (server only)
CRON_SECRET=
