{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run build)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npx *)",
      "Bash(rm *)",
      "Bash(supabase *)",
      "PowerShell(git push *)",
      "PowerShell(git pull *)",
      "PowerShell(npm install *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npx *)",
      "PowerShell(rm *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(supabase *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git rebase *)",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__claude_ai_Supabase__create_branch",
      "mcp__claude_ai_Supabase__create_edge_function_secret",
      "mcp__claude_ai_Supabase__create_notebook",
      "mcp__claude_ai_Supabase__create_project",
      "mcp__claude_ai_Supabase__delete_branch",
      "mcp__claude_ai_Supabase__delete_feedback",
      "mcp__claude_ai_Supabase__delete_notebook",
      "mcp__claude_ai_Supabase__deploy_edge_function",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__merge_branch",
      "mcp__claude_ai_Supabase__pause_project",
      "mcp__claude_ai_Supabase__rebase_branch",
      "mcp__claude_ai_Supabase__reset_branch",
      "mcp__claude_ai_Supabase__restore_project",
      "mcp__claude_ai_Supabase__run_notebook",
      "mcp__claude_ai_Supabase__submit_feedback",
      "mcp__claude_ai_Figma__add_code_connect_map",
      "mcp__claude_ai_Figma__create_generative_plugin",
      "mcp__claude_ai_Figma__create_new_file",
      "mcp__claude_ai_Figma__create_shader",
      "mcp__claude_ai_Figma__generate_diagram",
      "mcp__claude_ai_Figma__generate_image",
      "mcp__claude_ai_Figma__send_code_connect_mappings",
      "mcp__claude_ai_Figma__send_code_to_figma",
      "mcp__claude_ai_Figma__update_generative_plugin",
      "mcp__claude_ai_Figma__update_shader",
      "mcp__claude_ai_Figma__upload_assets",
      "mcp__claude_ai_Figma__use_figma",
      "mcp__claude_ai_Figma__weave_cancel_tool_run",
      "mcp__claude_ai_Figma__weave_run_model",
      "mcp__claude_ai_Figma__weave_run_tool",
      "mcp__claude_ai_Figma__weave_upload_asset"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shell.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-file.mjs\"",
            "timeout": 60,
            "statusMessage": "Linting edited file"
          }
        ]
      }
    ]
  }
}
